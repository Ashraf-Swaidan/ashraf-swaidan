[31m-```javascript[m
[31m-const tl = gsap.timeline({[m
[31m-  scrollTrigger: {[m
[31m-    trigger: ".container",[m
[31m-    start: "top top",[m
[31m-    end: "+=2000",[m
[31m-    scrub: 1,[m
