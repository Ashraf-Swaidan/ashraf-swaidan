[31m-    isDesktop: "(min-width: 800px)",[m
[31m-    isMobile: "(max-width: 799px)",[m
[31m-    reduceMotion: "(prefers-reduced-motion: reduce)"[m
[31m-  },[m
[31m-  (context) => {[m
[31m-    const { isDesktop, reduceMotion } = context.conditions;[m
