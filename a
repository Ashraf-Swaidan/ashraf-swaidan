[32m+[m[32m## Easing[m[41m[m
[32m+[m[41m[m
[32m+[m[32mUse string eases unless a custom curve is needed:[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mease: "power1.out"     // default feel[m[41m[m
[32m+[m[32mease: "power3.inOut"[m[41m[m
[32m+[m[32mease: "back.out(1.7)"  // overshoot[m[41m[m
[32m+[m[32mease: "elastic.out(1, 0.3)"[m[41m[m
[32m+[m[32mease: "none"           // linear[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32mBuilt-in eases: base (same as `.out`), `.in`, `.out`, `.inOut` where "power" refers to the strength of the curve (1 is more gradual, 4 is steepest):[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[32mbase (out)        .in                .out               .inOut[m[41m[m
[32m+[m[32m"none"[m[41m[m
[32m+[m[32m"power1"          "power1.in"        "power1.out"       "power1.inOut"[m[41m[m
[32m+[m[32m"power2"          "power2.in"        "power2.out"       "power2.inOut"[m[41m[m
[32m+[m[32m"power3"          "power3.in"        "power3.out"       "power3.inOut"[m[41m[m
[32m+[m[32m"power4"          "power4.in"        "power4.out"       "power4.inOut"[m[41m[m
[32m+[m[32m"back"            "back.in"          "back.out"         "back.inOut"[m[41m[m
[32m+[m[32m"bounce"          "bounce.in"        "bounce.out"      "bounce.inOut"[m[41m[m
[32m+[m[32m"circ"            "circ.in"          "circ.out"        "circ.inOut"[m[41m[m
[32m+[m[32m"elastic"         "elastic.in"       "elastic.out"     "elastic.inOut"[m[41m[m
[32m+[m[32m"expo"            "expo.in"          "expo.out"        "expo.inOut"[m[41m[m
[32m+[m[32m"sine"            "sine.in"          "sine.out"        "sine.inOut"[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m### Custom: use CustomEase (plugin)[m[41m[m
[32m+[m[41m[m
[32m+[m[32mSimple cubic-bezier values (as used in CSS `cubic-bezier()`):[m[41m [m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mconst myEase = CustomEase.create("my-ease", ".17,.67,.83,.67");[m[41m[m
[32m+[m[41m[m
[32m+[m[32mgsap.to(".item", {x: 100, ease: myEase, duration: 1});[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32mComplex curve with any number of control points, described as normalized SVG path data:[m[41m [m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mconst myEase = CustomEase.create("hop", "M0,0 C0,0 0.056,0.442 0.175,0.442 0.294,0.442 0.332,0 0.332,0 0.332,0 0.414,1 0.671,1 0.991,1 1,0 1,0");[m[41m[m
[32m+[m[41m[m
[32m+[m[32mgsap.to(".item", {x: 100, ease: myEase, duration: 1});[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Returning and Controlling Tweens[m[41m[m
[32m+[m[41m[m
[32m+[m[32mAll tween methods return a **Tween** instance. Store the return value when controlling playback is needed:[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mconst tween = gsap.to(".box", { x: 100, duration: 1, repeat: 1, yoyo: true });[m[41m[m
[32m+[m[32mtween.pause();[m[41m[m
[32m+[m[32mtween.play();[m[41m[m
[32m+[m[32mtween.reverse();[m[41m[m
[32m+[m[32mtween.kill();[m[41m[m
[32m+[m[32mtween.progress(0.5);[m[41m[m
[32m+[m[32mtween.time(0.2);[m[41m[m
[32m+[m[32mtween.totalTime(1.5);[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Function-based values[m[41m[m
[32m+[m[32mUse a function for a `vars` value and it will get called **once for each target** the first time the tween renders, and whatever is returned by that function will be used as the animation value.[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mgsap.to(".item", {[m[41m[m
[32m+[m[32m  x: (i, target, targetsArray) => i * 50, // first item animates to 0, the second to 50, the third to 100, etc.[m[41m[m
[32m+[m[32m  stagger: 0.1[m[41m[m
[32m+[m[32m});[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Relative values[m[41m[m
[32m+[m[41m[m
[32m+[m[32mUse a `+=`, `-=`, `*=`, or `/=` prefix to indicate a **relative** value. For example, the following will animate x to 20 pixels less than whatever it is when the tween renders for the first time.[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mgsap.to(".class", {x: "-=20" });[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[32m`x: "+=20"` would add 20 to the current value. `"*=2"` would multiply by 2, and `"/=2"` would divide by 2.[m[41m[m
[32m+[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Defaults[m[41m[m
[32m+[m[41m[m
[32m+[m[32mSet project-wide Tween defaults with **gsap.defaults()**:[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mgsap.defaults({ duration: 0.6, ease: "power2.out" });[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Accessibility and responsive (gsap.matchMedia())[m[41m[m
[32m+[m[41m[m
[32m+[m[32m**gsap.matchMedia()** (GSAP 3.11+) runs setup code only when a media query matches; when it stops matching, all animations and ScrollTriggers created in that run are **reverted automatically**. Use it for responsive breakpoints (e.g. desktop vs mobile) and for **prefers-reduced-motion** so users who prefer reduced motion get minimal or no animation.[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- **Create:** `let mm = gsap.matchMedia();`[m[41m[m
[32m+[m[32m- **Add a query:** `mm.add("(min-width: 800px)", () => { gsap.to(...); return () => { /* optional custom cleanup */ }; });`[m[41m[m
[32m+[m[32m- **Revert all:** `mm.revert();` (e.g. on component unmount).[m[41m[m
[32m+[m[32m- **Scope (optional):** Pass a third argument (element or ref) so selector text inside the handler is scoped to that root: `mm.add("(min-width: 800px)", () => { ... }, containerRef);`[m[41m[m
[32m+[m[41m[m
[32m+[m[32m**Conditions syntax** — Use an object to pass multiple named queries and avoid duplicate code; the handler receives a context with `context.conditions` (booleans per condition):[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```javascript[m[41m[m
[32m+[m[32mmm.add([m[41m[m
[32m+[m[32m  {[m[41m[m
[32m+[m[32m    isDesktop: "(min-width: 800px)",[m[41m[m
[32m+[m[32m    isMobile: "(max-width: 799px)",[m[41m[m
[32m+[m[32m    reduceMotion: "(prefers-reduced-motion: reduce)"[m[41m[m
[32m+[m[32m  },[m[41m[m
[32m+[m[32m  (context) => {[m[41m[m
[32m+[m[32m    const { isDesktop, reduceMotion } = context.conditions;[m[41m[m
[32m+[m[32m    gsap.to(".box", {[m[41m[m
[32m+[m[32m      rotation: isDesktop ? 360 : 180,[m[41m[m
[32m+[m[32m      duration: reduceMotion ? 0 : 2  // skip animation when user prefers reduced motion[m[41m[m
[32m+[m[32m    });[m[41m[m
[32m+[m[32m    return () => { /* optional cleanup when no condition matches */ };[m[41m[m
[32m+[m[32m  }[m[41m[m
[32m+[m[32m);[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32mRespecting **prefers-reduced-motion** is important for users with vestibular disorders. Use `duration: 0` or skip the animation when `reduceMotion` is true. Do not nest **gsap.context()** inside matchMedia — matchMedia creates a context internally; use **mm.revert()** only.[m[41m[m
[32m+[m[41m[m
[32m+[m[32mFull docs: [gsap.matchMedia()](https://gsap.com/docs/v3/GSAP/gsap.matchMedia/). For immediate re-run of all matching handlers (e.g. after toggling a reduced-motion control), use **gsap.matchMediaRefresh()**.[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Official GSAP best practices[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- ✅ Use **property names in camelCase** in vars (e.g. `backgroundColor`, `rotationX`).[m[41m[m
[32m+[m[32m- ✅ Prefer **transform aliases** (`x`, `y`, `scale`, `rotation`, `xPercent`, `yPercent`, etc.) over animating the raw `transform` string; use **autoAlpha** instead of `opacity` for fade in/out when elements should be hidden and non-interactive at 0.[m[41m[m
[32m+[m[32m- ✅ Use documented built-in eases; use CustomEase only when a custom curve is needed.[m[41m[m
[32m+[m[32m- ✅ Store the tween/timeline return value when controlling playback (pause, play, reverse, kill).[m[41m[m
[32m+[m[32m- ✅ Prefer timelines instead of chaining animations using `delay`.[m[41m[m
[32m+[m[32m- ✅ Use **gsap.matchMedia()** for responsive breakpoints and **prefers-reduced-motion** so animations can be reduced or disabled for accessibility.[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## Do Not[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- ❌ Animate layout-heavy properties (e.g. `width`, `height`, `top`, `left`) when transform aliases (`x`, `y`, `scale`, `rotation`) can achieve the same effect; prefer transforms for better performance.[m[41m[m
[32m+[m[32m- ❌ Use both **svgOrigin** and **transformOrigin** on the same SVG element; only one applies.[m[41m[m
[32m+[m[32m- ❌ Rely on the default **immediateRender: true** when stacking multiple **from()** or **fromTo()** tweens on the same property of the same target; set **immediateRender: false** on the later tweens so they animate correctly.[m[41m[m
[32m+[m[32m- ❌ Use invalid or non-existent ease names; stick to documented eases.[m[41m[m
[32m+[m[32m- ❌ Forget that **gsap.from()** uses the element’s current state as the end state; the initial values in the tween will be applied immediately unless `immediateRender: false` is in the `vars`.[m[41m[m
